        "exploration": {
          "roomName": "Ala centrale del museo",
          "imageList": [
            "historicCenter21.jpg"
          ],
          "imagesMap": {
            "historicCenter21.jpg": {
              "nextTypeOfScene": "Dialog",
              "nextScene": "Puzzle",
              "diary": "\nHo parlato con la guardia ed era visibilmente nervosa mentre raccontava l'accaduto. Mi ha spiegato che ieri un ragazzino era inciampato vicino alla reception, attirando l'attenzione di tutti per un istante. Si era avvicinato per assicurarsi che stesse bene e, abbassandosi per aiutarlo, aveva perso di vista il resto.\nIl tono della sua voce si abbasso'. Quando si era rialzato, aveva urtato per errore un uomo con una ventiquattrore. Non gli aveva dato importanza sul momento... ma piu' tardi, quando avevano svelato il furto del quadro, si era accorto che non aveva piu' le chiavi dell'ingresso secondario.\nUn dettaglio importante. Troppo importante per essere ignorato.\nOra non ho scelta: devo recarmi all'ingresso secondario. Se c'e' una traccia lasciata da quell'uomo o da chiunque altro sia coinvolto, sara' li'. Ogni dettaglio potrebbe fare la differenza, e non posso permettermi di perdere altro tempo.\n"

            }
          }
        },
        "dialogs": [
          {
            "investigator": "investigator.png",
            "interlocutor": "guard.png",
            "conversation": [
              {
                "speaker": "Investigatore",
                "id": 0,
                "text": "Mi scusi, guardia. Puo' dirmi se ha notato qualcosa di strano o sospetto riguardo al furto del quadro?"
              },
              {
                "speaker": "Guardia",
                "id": 2,
                "text": "Io... c'era... una valigetta... si, la chiave! E poi... il quadro... non lo so, e' sparito! Non so come sia successo!"
              },
              {
                "speaker": "Investigatore",
                "id": 1,
                "text": "Va bene, si calmi. Respiri. Mi racconti tutto con calma: chi aveva la valigetta? E questa chiave, di cosa si tratta?"
              }
            ]
          }
        ],
