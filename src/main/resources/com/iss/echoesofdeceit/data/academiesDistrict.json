            "academiesDistrict21.jpg": {
              "nextTypeOfScene": "Dialog",
              "nextScene": "Puzzle",
              "nextNextScene": "Dialog",
              "current": 0,
              "diary": "\nIl calligrafo mi ha dato una pista da seguire. Dopo aver analizzato attentamente l'inchiostro usato per scrivere la lettera, ha notato qualcosa di particolare: una composizione chimica insolita, caratteristica di un inchiostro venduto in pochi posti in citta'.\nTuttavia penso che la scelta corretta sia quella di andare nel negozio specializzato nel mercato. Un luogo poco frequentato, nascosto tra bancarelle e vicoli stretti. E' li' che devo andare ora.\n"
            }
          }
        },
        "dialogs": [
          {
            "investigator": "investigator.png",
            "interlocutor": "calligrafo.png",
            "conversation": [
              {
                "speaker": "Calligrafo",
                "id": 2,
                "text": "Guardando la lettera ho notato che e' stato utilizzato un inchiostro pregiato. Esistono solamente due negozi in questa citta' che lo vendono."
              },
              {
                "speaker": "Investigatore",
                "id": 1,
                "text": "Ottimo, ma come le ho detto, non ho tempo a sufficienza per visitarli entrambi..."
              },
              {
                "speaker": "Calligrafo",
                "id": 2,
                "text": "Certo, comprendo. Tieni qui ho le mappe dei quartieri dove si trovano i negozi. Dato il contesto penso possa comprendere quale sia la scelta migliore..."
              }
            ]
          },
          {
            "investigator": "investigator.png",
            "interlocutor": "calligrafo.png",
            "conversation": [
              {
                "speaker": "Investigatore",
                "id": 0,
                "text": "Perfetto, ora so dove mi devo dirigere. Grazie mille per il tempo dedicatomi, buona giornata."
              },
              {
                "speaker": "Calligrafo",
                "id": 2,
                "text": "Buona fortuna, speriamo di poter festeggiare con un una bottiglia di vino, anzi due!"
              }
            ]
          }
