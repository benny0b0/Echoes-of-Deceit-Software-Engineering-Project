        "dialogs": [
          {
            "investigator": "investigator.png",
            "interlocutor": "bambini.png",
            "conversation": [
              {
                "speaker": "Investigatore",
                "id": 0,
                "text": "Buongiorni bambini, sto cercando una dimora abbandonata in questo quartiere, sapreste aiutarmi?"
              },
              {
                "speaker": "Bambini",
                "id": 2,
                "text": "Tu sei davvero l'investigatore investigatore famoso che e' venuto nella nostra citta'?"
              },
              {
                "speaker": "Investigatore",
                "id": 1,
                "text": "Si sono io, avete visto qualcosa legato al furto del quadro?"
              },
              {
                "speaker": "Bambini",
                "id": 2,
                "text": "Si abbiamo visto qualcosa di sospetto. Ma prima di dirtelo dimostra quanto sei bravo e risolvi questo compito che ci hanno lasciato le maestre a scuola!"
              }
            ]
          },
          {
            "investigator": "investigator.png",
            "interlocutor": "bambini.png",
            "conversation": [
              {
                "speaker": "Investigatore",
                "id": 0,
                "text": "Bene ragazzi ecco qui la soluzione: 1. In questo modo, tutte le righe, le diagonali e le colonne hanno come somma 15."
              },
              {
                "speaker": "Bambini",
                "id": 2,
                "text": "Wow, signor investigatore, e' davvero bravissimo! Come fa a capire tutto cosi' in fretta?"
              },
              {
                "speaker": "Investigatore",
                "id": 1,
                "text": "Grazie, ragazzi. Ma ora ho bisogno del vostro aiuto. Sapete qualcosa sulla casa abbandonata di questo quartiere?"
              },
              {
                "speaker": "Bambini",
                "id": 2,
                "text": "Certo! La trovi se segui queste parole: Dove i fiori non crescono e il vento sussurra, la' il mistero si chiude nella curva piu' scura.\nAddio ihihih."
              },
              {
                "speaker": "Investigatore",
                "id": 1,
                "text": "Hey, aspettate un attimo, siate piu' precisi!\n... sono scappati..."
              }
            ]
          }
