<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="mainStackPane" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iss.echoesofdeceit.controller.ZonePreviewController">
    <children>
        <BorderPane>
            <top>
                <StackPane BorderPane.alignment="CENTER">
                    <children>
                          <Label fx:id="zoneName" styleClass="zone-name" text="" />
                        <BorderPane>
                            <right>
                                <Button fx:id="pauseButton" mnemonicParsing="false" styleClass="top-hbox-buttons" text="Pausa" />
                            </right>
                        </BorderPane>
                    </children>
               <BorderPane.margin>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </BorderPane.margin>
                </StackPane>
            </top>
         <bottom>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="20.0" BorderPane.alignment="CENTER">
               <children>
                  <Button fx:id="beginInvestigation" alignment="CENTER" mnemonicParsing="false" styleClass="enter-zone-button" text="Indaga" />
               </children>
               <BorderPane.margin>
                  <Insets bottom="30.0" />
               </BorderPane.margin>
            </HBox>
         </bottom>
        </BorderPane>
    </children>
</StackPane>
