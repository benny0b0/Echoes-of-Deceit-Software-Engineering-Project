<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="mainStackPane" styleClass="stack-hint" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iss.echoesofdeceit.controller.NewGameController">
   <children>
      <BorderPane>
         <center>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" spacing="10" styleClass="vbox-hint" BorderPane.alignment="CENTER">
               <children>
                  <Label alignment="CENTER" contentDisplay="CENTER" style="-fx-font-size: 35px; -fx-font-weight: bold;" styleClass="description-text" text="Crea un nuovo utente" />
                  <Label alignment="CENTER" contentDisplay="CENTER" maxWidth="600" styleClass="description-text" text="Benvenuto in Echoes of Deceit, dove ogni indizio ti avvicina alla verita'. Crea il tuo profilo scegliendo un nome e preparati a risolvere enigmi che metteranno alla prova la tua astuzia. La tua avventura investigativa inizia ora!" textAlignment="JUSTIFY" wrapText="true" />
                  <Label visible="false" />
                  <TextField fx:id="nameField" alignment="CENTER" promptText="Inserisci il tuo nome" styleClass="name-textfield">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </TextField>
                  <Label fx:id="errorLabel" alignment="CENTER" contentDisplay="CENTER" maxWidth="600.0" nodeOrientation="LEFT_TO_RIGHT" style=" -fx-text-fill: red;" styleClass="description-text" wrapText="true" />
                  <HBox alignment="CENTER" spacing="50.0">
                     <children>
                        <Button fx:id="startButton" minWidth="230.0" mnemonicParsing="false" styleClass="buttonPuzzle" text="Avvia Partita" />
                        <Button fx:id="exitNewGameButton" mnemonicParsing="false" styleClass="buttonPuzzle" text="Menu Principale" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>
