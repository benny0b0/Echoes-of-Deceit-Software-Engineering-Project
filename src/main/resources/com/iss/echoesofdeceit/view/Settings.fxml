<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="mainMenu-stack-pane" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iss.echoesofdeceit.controller.SettingsController">
   <children>
      <BorderPane maxHeight="500.0" maxWidth="500.0" styleClass="settings-vbox">
         <top>
            <Label style="-fx-font-size: 40px;" styleClass="description-text" text="Impostazioni" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets top="20.0" />
               </BorderPane.margin>
            </Label>
         </top>
         <bottom>
             <Button fx:id="btnExitSettings" mnemonicParsing="false" styleClass="button-menu" text="Torna al gioco" BorderPane.alignment="CENTER">
               <BorderPane.margin>
                  <Insets bottom="20.0" />
               </BorderPane.margin>
            </Button>
         </bottom>
         <center>
            <VBox alignment="CENTER" spacing="40.0" BorderPane.alignment="CENTER">
               <children>
                  <VBox alignment="CENTER">
                     <children>
                        <Label styleClass="description-text" text="Audio" />
                        <AnchorPane>
                           <children>
                              <Label styleClass="description-text" text="Volume musica" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
                              <HBox alignment="TOP_CENTER" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                 <children>
                                    <Button fx:id="btnDecrementMusic" mnemonicParsing="false" styleClass="button-settings" text="-" />
                                    <Label fx:id="musicVolumeLabel" styleClass="description-text">
                                       <padding>
                                          <Insets left="10.0" right="10.0" />
                                       </padding>
                                    </Label>
                                    <Button fx:id="btnInrementMusic" mnemonicParsing="false" styleClass="button-settings" text="+" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                        <AnchorPane>
                           <children>
                              <Label styleClass="description-text" text="Volume suoni" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
                              <HBox alignment="TOP_CENTER" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                 <children>
                                    <Button fx:id="btnDecrementSound" mnemonicParsing="false" styleClass="button-settings" text="-" />
                                    <Label fx:id="soundMusicLabel" styleClass="description-text">
                                       <padding>
                                          <Insets left="10.0" right="10.0" />
                                       </padding>
                                    </Label>
                                    <Button fx:id="btnInrementSound" mnemonicParsing="false" styleClass="button-settings" text="+" />
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </VBox>
                  <VBox alignment="CENTER">
                     <children>
                        <Label styleClass="description-text" text="Schermo" />
                        <AnchorPane>
                           <children>
                              <Label styleClass="description-text" text="Risoluzione" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0" />
                              <HBox alignment="TOP_CENTER" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">
                                 <children>
                                    <Label style="-fx-opacity: 0.6;" styleClass="description-text" text="1920x1080">
                                       <padding>
                                          <Insets left="10.0" right="10.0" />
                                       </padding>
                                    </Label>
                                 </children>
                              </HBox>
                           </children>
                        </AnchorPane>
                     </children>
                  </VBox>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>
