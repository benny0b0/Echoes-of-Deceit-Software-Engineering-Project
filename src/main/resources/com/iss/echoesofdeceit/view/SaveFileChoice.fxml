<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="mainStackPane" style="-fx-background-color: transparent" styleClass="stack-hint" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iss.echoesofdeceit.controller.SaveFileController">
   <children>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <center>
            <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="551.0" minWidth="-Infinity" spacing="20.0" styleClass="vbox-hint" BorderPane.alignment="CENTER">
               <children>
                  <Label style="-fx-font-size: 35px; -fx-font-weight: bold;" styleClass="description-text" text="Seleziona un salvataggio" />
                  <Label maxWidth="600.0" styleClass="description-text" text="Ogni salvataggio rappresenta un capitolo della tua indagine, ordinato dal piu' recente. Rivisita i tuoi progressi, analizza gli indizi raccolti e riprendi l'esplorazione dal punto in cui l'hai lasciata. La verita' ti aspetta." textAlignment="JUSTIFY" wrapText="true" />
                  <ScrollPane fitToHeight="true" fitToWidth="true" maxHeight="500.0" styleClass="scroll-pane-puzzle">
                     <content>
                        <VBox fx:id="saveFileContainer" alignment="CENTER" styleClass="vbox-choice-saves" />
                     </content>
                  </ScrollPane>
                  <Button fx:id="exitSaveChoice" mnemonicParsing="false" styleClass="buttonPuzzle" text="Menu Principale" />
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>
