<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="mainStackPane" styleClass="main-stack-pane" stylesheets="@../styles/global.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.iss.echoesofdeceit.controller.DialogController">
    <children>
        <Region prefHeight="200.0" prefWidth="200.0" styleClass="blur-overlay" />
        <AnchorPane prefHeight="200.0" prefWidth="200.0" styleClass="dialog-anchor-pane1">
            <children>
                <ImageView fx:id="oneContainer" fitHeight="710.0" pickOnBounds="true" preserveRatio="true" styleClass="dialog-image" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="100.0" />
                <ImageView fx:id="twoContainer" fitHeight="700.0" pickOnBounds="true" preserveRatio="true" styleClass="dialog-image" AnchorPane.bottomAnchor="0.0" AnchorPane.rightAnchor="100.0" />
            </children>
         <StackPane.margin>
            <Insets bottom="40.0" />
         </StackPane.margin>
        </AnchorPane>
        <BorderPane prefHeight="200.0" prefWidth="200.0" styleClass="border-pane1">
            <bottom>
                <StackPane prefHeight="150.0" prefWidth="200.0" styleClass="dialog-bottom-stack-pane" BorderPane.alignment="CENTER">
                    <children>
                        <VBox prefHeight="200.0" prefWidth="100.0">
                            <children>
                        <AnchorPane prefHeight="200.0" prefWidth="200.0">
                           <children>
                                      <Label fx:id="name" styleClass="dialog-label" AnchorPane.leftAnchor="0.0" />
                              <Button fx:id="next" mnemonicParsing="false" text="Avanti" AnchorPane.rightAnchor="10.0" />
                           </children>
                        </AnchorPane>
                                <StackPane alignment="TOP_LEFT" minHeight="250.0" styleClass="dialog-stack-pane-2">
                                    <children>
                              <Label fx:id="conversation" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" styleClass="dialog-conversation" wrapText="true" StackPane.alignment="TOP_LEFT">
                                 <StackPane.margin>
                                    <Insets />
                                 </StackPane.margin></Label>
                                    </children>
                                </StackPane>
                            </children>
                        </VBox>
                    </children>
               <BorderPane.margin>
                  <Insets bottom="15.0" />
               </BorderPane.margin>
                </StackPane>
            </bottom>
        </BorderPane>
    </children>
</StackPane>
